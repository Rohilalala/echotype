{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echotype",
  "version": "0.1.0",
  "identifier": "app.echotype.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Echotype",
        "width": 800,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "sounds/*/*.wav"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2"
        ]
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBNDJCMjJBOEZDREI1RTMKUldUanRjMlBLckpDS3I2aGpuQ0NISGVzT0FsWC82QW9nU1VyK2Fyd3UyZXRUS3pza3oyUkpLT3AK",
      "endpoints": [
        "https://github.com/Rohilalala/echotype/releases/latest/download/latest.json"
      ]
    }
  }
}
