{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "The pill: listens to dictation events and may call the pill commands only",
  "windows": [
    "overlay"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-pill-click",
    "allow-pill-cancel",
    "allow-pill-open",
    "allow-pill-menu",
    "allow-pill-drag",
    "allow-pill-reset",
    "allow-pill-copy",
    "allow-pill-dismiss"
  ]
}
